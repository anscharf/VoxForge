{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "VoxForge",
  "version": "1.0.0",
  "identifier": "com.voxforge.app",
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/whisper"
    ],
    "resources": [
      "resources/models/*.bin"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": null,
      "exceptionDomain": "",
      "frameworks": [],
      "signingIdentity": null,
      "infoPlist": "Info.plist"
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  },
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "VoxForge",
        "width": 900,
        "height": 700,
        "minWidth": 600,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; connect-src 'self' http://localhost:11434 http://127.0.0.1:11434 http://[::1]:11434; style-src 'self' 'unsafe-inline'"
    }
  }
}
